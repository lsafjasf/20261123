  <library>
    <event name="DEPT_B">
      <project name="DEPT_B_25">
        <sequence format="r1" tcStart="0s" tcFormat="NDF">
          <spine>
            <asset-clip ref="a1" name="B_WIDE_SHOT" offset="0s" start="0s" duration="125/25s"/>
            <asset-clip ref="a2" name="B_CLOSE_UP" offset="125/25s" start="100/25s" duration="200/25s">
              <transition name="Cross Dissolve" offset="125/25s" duration="25/25s"/>
