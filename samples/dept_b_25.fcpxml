            <title ref="r9" name="B_LOWER_THIRD" offset="200/25s" start="0s" duration="75/25s" lane="1"/>
            <asset-clip ref="a4" name="B_VOICEOVER" offset="0s" start="0s" duration="300/25s" lane="-1"/>
